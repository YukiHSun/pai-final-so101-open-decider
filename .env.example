# Hosted Jev (TypeSafe). Not needed when DECIDER_URL points at a local decision model.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Local decision model with the same /v1/systemone API (strands-decider or H2O-Lightning-4B)
# DECIDER_URL=http://127.0.0.1:8741

# OpenRouter decision models (elephant-1, mammoth-1, ...)
# DECIDER_URL=https://openrouter.ai/api/alpha/decisions
# DECIDER_MODEL=baseten/mammoth-1:free
# OPENROUTER_API_KEY=
